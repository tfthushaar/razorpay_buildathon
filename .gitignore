# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env / secrets
.env
.env.*
!.env.example
# Holds a provider name, not a secret, and it has to ship or the deployed build falls back to the
# local default (ollama), which the hosted backend cannot run. See frontend/src/components/RunControls.tsx.
!frontend/.env.production

# Data / DB (generated, not source)
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/generated/

# Dev-server logs (redirected here occasionally by ad hoc verification runs, not project content)
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code session/tooling metadata (not project content)
.claude/
