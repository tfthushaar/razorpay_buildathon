# Copy to .env and fill in. Never commit the real .env (already gitignored).

# "mock" (default, zero-cost, deterministic), "ollama" (recommended real provider — local,
# zero cost, zero rate limit; requires `ollama pull qwen2.5:7b-instruct`, no API key), or "groq"
# (hosted, needs GROQ_API_KEY, free tier is rate-limited — see BUILD_LOG.md)
LLM_PROVIDER=mock

# Free tier at https://console.groq.com — only needed when LLM_PROVIDER=groq
GROQ_API_KEY=
